# Build and test artifacts for this package.
#
# This file also decides what an sdist carries. hatchling locates a .gitignore
# by walking up from the package until it reaches .git, force-includes whichever
# one it found, and consults no setting that can stop it. Without a .gitignore
# here it walks to the repository root and publishes that one, which describes
# this repository's local tooling and means nothing to somebody who unpacked a
# single package from PyPI.

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
