#!/bin/sh
# Pre-commit gates, run against the STAGED files only.
#
# A real finding BLOCKS the commit. A missing tool WARNS and allows, because CI
# is the hard backstop (.github/workflows/lint.yml runs all of this repo-wide).
#
# Gates, in order:
#   0. IP hygiene     - client and employer names, and internal-document markers
#   1. prose          - documentation standard conformance
#   2. nondeterminism - no direct clock, RNG, or socket calls outside the kernel
#   3. ruff           - lint and format check on Python
#   4. markdownlint   - Markdown
#   5. shellcheck     - shell
#   6. actionlint     - workflows
#
# Bypass:
#   LINT_OK=1 git commit ...     skip these lint gates, keep commit-msg checks
#   git commit --no-verify ...   skip every hook
#
# Gate 0 is outside both bypasses on purpose, and is the only gate that is. The
# others guard style, and a style finding costs a follow-up commit. Gate 0
# guards a disclosure into a public history, and that costs a history rewrite,
# so it runs before the bypass is read.
set -u

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

# --- 0. IP hygiene ----------------------------------------------------------
# One resolution for every gate below, and for commit-msg, which sources the
# same file. See its header for the startup measurement that picks the order.
# shellcheck source=scripts/hooks/resolve-python.sh
. scripts/hooks/resolve-python.sh
IP_PY="$HOOK_PY"
if [ -n "$IP_PY" ] && [ -f scripts/checks/banned-terms-gate.py ]; then
  # Word splitting is the point: IP_PY may be a command with arguments.
  # shellcheck disable=SC2086
  $IP_PY scripts/checks/banned-terms-gate.py --staged || exit 1
else
  echo "[ip-hygiene] WARN: no python interpreter, skipped. CI runs the generic half."
fi

if [ "${LINT_OK:-}" = "1" ]; then
  echo "[pre-commit] bypassed via LINT_OK=1"
  exit 0
fi

fail=0
staged() { git diff --cached --name-only --diff-filter=ACM -- "$@" || true; }

# The prose gate reads its rules out of docs/style/, so it needs PyYAML.
# resolve-python.sh, sourced above, picks an interpreter that carries it.
PY="$HOOK_PY_YAML"

# --- 1. prose ---------------------------------------------------------------
if [ -n "$PY" ]; then
  $PY scripts/checks/prose-gate.py --staged || fail=1
else
  echo "[prose] WARN: no python interpreter, skipped (CI gates)."
fi

# --- 1b. spelling -----------------------------------------------------------
# British variants and common misspellings, over the staged files. The rules
# live in docs/style/spelling.yml and this hook owns none of them.
if [ -n "$PY" ]; then
  $PY scripts/checks/spelling-gate.py || fail=1
else
  echo "[spelling] WARN: no python interpreter, skipped (CI gates)."
fi

# --- 2. nondeterminism ------------------------------------------------------
sh scripts/checks/nondeterminism-gate.sh --staged || fail=1

# --- 3. Python --------------------------------------------------------------
pyfiles=$(staged '*.py')
if [ -n "$pyfiles" ]; then
  RUFF=""
  if command -v ruff >/dev/null 2>&1; then
    RUFF="ruff"
  # Only use uvx when it can actually produce ruff right now. A fetch failure
  # while offline has to warn and skip like a missing tool, not block the
  # commit as though ruff had found something.
  elif command -v uvx >/dev/null 2>&1 && uvx ruff --version >/dev/null 2>&1; then
    RUFF="uvx ruff"
  fi
  if [ -n "$RUFF" ]; then
    # --force-exclude: ruff ignores its config exclusions when paths are passed
    # explicitly, which is exactly what a hook must do.
    # shellcheck disable=SC2086
    $RUFF check --force-exclude $pyfiles || { echo "[ruff] BLOCKED: fix with 'ruff check --fix'"; fail=1; }
    # shellcheck disable=SC2086
    $RUFF format --check --force-exclude $pyfiles || { echo "[ruff-format] BLOCKED: run 'ruff format'"; fail=1; }
  else
    echo "[ruff] WARN: ruff not installed, skipped (CI gates). Install: uv tool install ruff"
  fi
fi

# --- 4. Markdown ------------------------------------------------------------
mdfiles=$(staged '*.md')
if [ -n "$mdfiles" ]; then
  MDL=""
  if command -v markdownlint-cli2 >/dev/null 2>&1; then
    MDL="markdownlint-cli2"
  elif command -v npx >/dev/null 2>&1 && npx --no-install markdownlint-cli2 --help >/dev/null 2>&1; then
    MDL="npx --no-install markdownlint-cli2"
  fi
  if [ -n "$MDL" ]; then
    # shellcheck disable=SC2086
    $MDL $mdfiles || { echo "[markdownlint] BLOCKED: see .markdownlint.jsonc"; fail=1; }
  else
    echo "[markdownlint] WARN: not available, skipped (CI gates). Install: npm i -g markdownlint-cli2"
  fi
fi

# --- 5. Shell ---------------------------------------------------------------
# The staged set narrowed to the files that are shell scripts. scripts/hooks/
# holds the git hooks, which have no suffix, beside comment_judge.py, which is
# Python: shellcheck reports a parse error for every docstring in it.
shfiles=$(staged '*.sh' 'scripts/hooks/*')
if [ -n "$shfiles" ]; then
  known=$(sh scripts/checks/shell-files.sh)
  kept=""
  for candidate in $shfiles; do
    for known_file in $known; do
      if [ "$candidate" = "$known_file" ]; then
        kept="$kept $candidate"
        break
      fi
    done
  done
  shfiles=$kept
fi
if [ -n "$shfiles" ]; then
  # uvx serves the binary from PyPI where the tool is not on PATH, so this gate
  # runs on a machine with no package manager rather than reporting a skip.
  SHELLCHECK=""
  if command -v shellcheck >/dev/null 2>&1; then
    SHELLCHECK="shellcheck"
  elif command -v uvx >/dev/null 2>&1; then
    SHELLCHECK="uvx --from shellcheck-py shellcheck"
  fi
  if [ -n "$SHELLCHECK" ]; then
    # shellcheck disable=SC2086
    $SHELLCHECK $shfiles || { echo "[shellcheck] BLOCKED: shell issues above"; fail=1; }
  else
    echo "[shellcheck] WARN: no shellcheck and no uvx, skipped (CI gates)."
  fi
fi

# --- 6. Workflows -----------------------------------------------------------
ymlfiles=$(staged '.github/workflows/*.yml' '.github/workflows/*.yaml')
if [ -n "$ymlfiles" ]; then
  ACTIONLINT=""
  if command -v actionlint >/dev/null 2>&1; then
    ACTIONLINT="actionlint"
  elif command -v uvx >/dev/null 2>&1; then
    ACTIONLINT="uvx --with shellcheck-py --from actionlint-py actionlint"
  fi
  if [ -n "$ACTIONLINT" ]; then
    # shellcheck disable=SC2086
    $ACTIONLINT $ymlfiles || { echo "[actionlint] BLOCKED: workflow issues above"; fail=1; }
  else
    echo "[actionlint] WARN: no actionlint and no uvx, skipped (CI gates)."
  fi
fi

# The judgement half of the writing rules: whether a comment restates the code,
# and whether prose narrates a change instead of describing what is there. The
# prose gate above owns everything mechanical. This one fails open when the CLI
# is unavailable, so a network blip never blocks a commit.
if [ "${COMMENT_JUDGE:-1}" != "0" ] && [ -f scripts/hooks/comment_judge.py ]; then
  # The same interpreter the prose gate resolved above. A bare `python` is not
  # the same thing on every machine: a wrapper that insists on `uv run python`
  # rejects the direct call, and the judge then fails open every time on a
  # machine where it would have run perfectly well through uv.
  JUDGE_PY="$PY"
  if [ -z "$JUDGE_PY" ]; then
    for candidate in python3 python; do
      command -v "$candidate" >/dev/null 2>&1 && { JUDGE_PY="$candidate"; break; }
    done
  fi
  if [ -n "$JUDGE_PY" ]; then
    # Word splitting is the point: $PY is a command with arguments.
    # shellcheck disable=SC2086
    $JUDGE_PY scripts/hooks/comment_judge.py
    # Only 3 means the judge ran and found something. Any other non-zero is a
    # launcher or interpreter problem, which fails open like every other
    # infrastructure failure: an author cannot act on it.
    [ "$?" = "3" ] && fail=1
  fi
fi

if [ "$fail" != 0 ]; then
  echo ""
  echo "[pre-commit] commit blocked. Fix the findings, or bypass once you have"
  echo "reviewed them:"
  echo "    LINT_OK=1 git commit ...     skip the lint gates"
  echo "    COMMENT_JUDGE=0 git commit ...  skip the judge only"
  echo "    git commit --no-verify ...   skip every hook"
  exit 1
fi
exit 0
