# GENERATED by tools/gen_importlinter.py from [tool.twinflow.layers] in
# pyproject.toml. Do not edit by hand: run the generator instead, and the
# --check mode in CI fails when this file and that table disagree.
#
# Boundary rules A1.1 through A1.3 of docs/design/foundations.md section 2.9.


[importlinter]
root_packages =
    twinflow

[importlinter:contract:layers]
name = A1.3 layering, apps down to schemas
type = layers
layers =
    twinflow.api | twinflow.dashboard
    twinflow.twin | twinflow.sensors | twinflow.agent
    twinflow.storage
    twinflow.config
    twinflow.kernel
    twinflow.rng
    twinflow.schemas

[importlinter:contract:domain-independence]
name = A1.2 domain packages are independent
type = independence
modules =
    twinflow.twin
    twinflow.sensors
    twinflow.agent

[importlinter:contract:private-agent]
name = A1.1 twinflow.agent private modules stay private
type = forbidden
source_modules =
    twinflow.api
    twinflow.config
    twinflow.dashboard
    twinflow.kernel
    twinflow.rng
    twinflow.schemas
    twinflow.sensors
    twinflow.storage
    twinflow.twin
forbidden_modules =
    twinflow.agent._impl
    twinflow.agent._internal
allow_indirect_imports = True

